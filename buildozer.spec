[app]

# App name
title = Hello Meshach

# Package name
package.name = hellomeshach

# Package domain
package.domain = org.meshach

# Source folder
source.dir = .

# Main Python file
source.include_exts = py,png,jpg,kv,atlas

# Version
version = 1.0

# Python requirements
requirements = python3,kivy

# Orientation
orientation = portrait

# Android permissions
android.permissions =

# Fullscreen
fullscreen = 0


[buildozer]

# Log level
log_level = 2

# Warning level
warn_on_root = 1
